import re

def check_password_strength(password):
    score = 0
    
    # Criteria checks
    length_criteria = len(password) >= 8
    upper_criteria = re.search(r'[A-Z]', password) is not None
    lower_criteria = re.search(r'[a-z]', password) is not None
    digit_criteria = re.search(r'[0-9]', password) is not None
    symbol_criteria = re.search(r'[@$!%*?&_#^()\-+=]', password) is not None

    # Tally score
    criteria_matches = [length_criteria, upper_criteria, lower_criteria, digit_criteria, symbol_criteria]
    score = sum(criteria_matches)

    # Determine strength level
    if score == 5 and len(password) >= 12:
        return "Very Strong"
    elif score == 5:
        return "Strong"
    elif score >= 3:
        return "Moderate"
    else:
        return "Weak"

# Example usage
user_input = input("Enter your password: ")
strength = check_password_strength(user_input)
print(f"Password Strength: {strength}")
